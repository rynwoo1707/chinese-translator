# Chép thành .env cạnh docker-compose.yml rồi điền:  cp env.example .env && chmod 600 .env
# .env đã nằm trong .gitignore: không commit, không gửi qua chat hay email.

# Tên miền công khai của dịch vụ PDF: bản ghi A/AAAA trỏ thẳng về máy chủ này (Cloudflare: DNS only, mây xám).
PDF_DOMAIN=pdf.example.com
# Email nhận thông báo của Let's Encrypt/ZeroSSL về chứng chỉ.
ACME_EMAIL=ban@example.com
# Giống hệt secret PDF_LAYOUT_SERVICE_TOKEN của Worker. Sinh bằng: openssl rand -hex 32
PDF_LAYOUT_SERVICE_TOKEN=

# Tùy chọn: giới hạn của container dịch vụ PDF (mặc định 2 CPU, 3g RAM). Máy 1 CPU thì đặt PDF_LAYOUT_CPUS=1.
# PDF_LAYOUT_CPUS=2
# PDF_LAYOUT_MEMORY=3g
