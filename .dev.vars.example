# Local settings for `wrangler dev`. `npm run setup` copies this file to .dev.vars (git-ignored) and fills in
# ADMIN_TOKEN and PDF_LAYOUT_SERVICE_TOKEN with random values. Never commit .dev.vars.
# Keep plain KEY=value lines: no `export`, no comment after a value.

# Optional server key, used only by the admin book pipeline (/admin). Students paste their own key in /study.html.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: model for repairing a verified missing footnote/year marker and for the student "Đối chiếu kỹ" mode; empty = defaults.
GEMINI_QUALITY_MODEL=
# Optional: admin book pipeline reasoning. Empty = translation 'minimal', OCR 'low'. Use 'low' or 'default' (model's unbounded thinking, most tokens).
GEMINI_THINKING=
# Password for the /admin page and the key that encrypts a Gemini key saved there. Use a long random value.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional Google login: both values from a Google Cloud OAuth client (redirect URI <site>/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stateless Python/Chromium service. Use HTTPS outside localhost; token is never sent to the browser.
PDF_LAYOUT_SERVICE_URL=http://127.0.0.1:8091
PDF_LAYOUT_SERVICE_TOKEN=
# Optional: leave empty to use GEMINI_MODEL for PDF blocks too.
GEMINI_PDF_BLOCK_MODEL=
# Optional, local PDF service only (npm run setup writes them when this machine needs them):
# PDF_PYTHON=, CHROMIUM_EXECUTABLE_PATH=, PDF_FONT_PATH=
