# Local settings for `wrangler dev`. `npm run setup` copies this file to .dev.vars (git-ignored) and fills in
# ADMIN_TOKEN and PDF_LAYOUT_SERVICE_TOKEN with random values. Never commit .dev.vars.
# Keep plain KEY=value lines: no `export`, no comment after a value.
# Non-secret defaults (model names, REGISTRATION_MODE) live in "vars" of wrangler.jsonc and apply to production too;
# a line here overrides one only on this machine. The secrets below exist only here locally; production gets them with
# `wrangler secret put` or `npm run deploy -- --secrets-file <file outside the repo>`, never from this file.

# Optional server key, used only by the admin book pipeline (/admin). Students paste their own key in /study.html.
GEMINI_API_KEY=
# Same as the wrangler.jsonc default; local scripts (backend/check-gemini-runtime.mjs) read it from here.
GEMINI_MODEL=gemini-3.6-flash
# Optional: model for repairing a verified missing footnote/year marker and for the student "Kỹ hơn" mode; empty = defaults.
GEMINI_QUALITY_MODEL=
# Optional: model for the "Kỹ nhất" mode (a Flash model, like every student mode); empty = GEMINI_MODEL.
GEMINI_PREMIUM_MODEL=
# Optional: the "Cách dịch" of admin book jobs that name none, and the one Xưởng dịch preselects in a browser signed in
# to /admin: economy, balanced, quality or premium; empty = premium.
ADMIN_TRANSLATION_MODE=
# Optional: one reasoning level for every step of the admin book pipeline: 'minimal', 'low', 'medium', 'high' or 'default'
# (model's unbounded thinking, most tokens). Empty = the levels of the job's "Cách dịch". Any other value is ignored like
# empty (npm run deploy warns about such a value in wrangler.jsonc).
GEMINI_THINKING=
# Typed once on /admin to create the first admin account, and again only to reset an admin password. Also the key that
# encrypts the Gemini key saved in Settings and keys the login-failure counters; CLI tools send it as a Bearer token.
# Use a long random value (at least 32 characters; only this machine accepts a shorter one).
ADMIN_TOKEN=replace-with-a-long-random-secret
# Optional Google login: both values from a Google Cloud OAuth client (redirect URI <site>/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stateless Python/Chromium service. Use HTTPS outside localhost; token is never sent to the browser.
PDF_LAYOUT_SERVICE_URL=http://127.0.0.1:8091
PDF_LAYOUT_SERVICE_TOKEN=
# Optional: leave empty to use GEMINI_MODEL for PDF blocks too.
GEMINI_PDF_BLOCK_MODEL=
# Optional, local PDF service only (npm run setup writes them when this machine needs them):
# PDF_PYTHON=, CHROMIUM_EXECUTABLE_PATH=, PDF_FONT_PATH=
